{
  "name": "network-sonar",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "dev:backend": "HOST=127.0.0.1 PORT=4173 pnpm --filter backend run dev",
    "dev:frontend": "pnpm --filter frontend run dev",
    "build": "pnpm run build:frontend && pnpm run build:backend",
    "build:frontend": "pnpm --filter frontend run build",
    "build:backend": "pnpm --filter backend run build",
    "start": "NODE_ENV=production pnpm --filter backend run start",
    "lint": "eslint .",
    "typecheck": "pnpm run typecheck:backend && pnpm run typecheck:frontend && tsc -p tsconfig.tests.json --noEmit",
    "typecheck:backend": "pnpm --filter backend run typecheck",
    "typecheck:frontend": "pnpm --filter frontend run typecheck",
    "test": "pnpm run test:unit && pnpm run test:contract && pnpm run test:integration",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^6.0.2",
    "better-sqlite3": "^11.9.1",
    "eslint": "^9.24.0",
    "express": "^5.1.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "npm-run-all": "^4.1.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "supertest": "^7.1.0",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.28.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.0"
  }
}
